# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your own values.
# In production, set the same keys in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Required. From Cloudinary Console → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret

# Optional. Exposed to the browser, used only to build preview URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Optional. Folder every asset is written into. Default: kiln
KILN_FOLDER=kiln

# Optional. Serve Cloudinary's public demo cloud instead of generating.
# Leave unset for normal use. The app switches this on by itself when the three
# credentials above are missing, so it never shows a blank screen.
KILN_DEMO_MODE=false

# Optional. Base URL for the Image Generation API. Only change this if the
# reference page in your Cloudinary console shows a different host.
# CLOUDINARY_IMAGEGEN_BASE=https://api.cloudinary.com/v2

# Optional. Font for the burned-in headline on channel-kit derivatives.
# Default is Roboto (a Cloudinary built-in), which accepts the `bold` keyword.
#
# Google Fonts work too, via an @google suffix - but NOT together with `bold`.
# Cloudinary forwards the weight to the Google Fonts API, which only accepts
# numeric weights, so `Archivo@google` + `bold` returns HTTP 400 on every
# derivative. Use an empty weight instead. `npm run verify` probes the
# combinations and tells you which ones render on your account.
# KILN_TEXT_FONT=Archivo@google
# KILN_TEXT_WEIGHT=
